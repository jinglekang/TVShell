<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/page_pointer_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <View
            android:id="@+id/page_pointer_cursor"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/page_pointer_cursor"
            android:clickable="false"
            android:focusable="false" />

        <TextView
            android:id="@+id/page_pointer_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_url_chip"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/pointer_hint"
            android:textColor="@color/tv_text"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/home_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:descendantFocusability="afterDescendants"
        android:paddingStart="96dp"
        android:paddingEnd="96dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/title_home"
            android:textAllCaps="true"
            android:textColor="@color/tv_text"
            android:textSize="52sp"
            android:textStyle="bold" />

        <View
            android:layout_width="56dp"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_accent_bar" />

        <TextView
            android:id="@+id/tv_home_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/subtitle_home"
            android:textColor="@color/tv_text_muted"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="760dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/edit_text_tv_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/et_url"
                android:nextFocusRight="@id/btn_visit"
                android:nextFocusUp="@id/et_url"
                android:nextFocusDown="@id/btn_home_phone_remote"
                android:hint="@string/hint_enter_url"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:tag="url_input_field"
                android:textColor="@color/tv_text"
                android:textColorHint="@color/tv_text_hint"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btn_visit"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_tv_primary_selector"
                android:contentDescription="@string/btn_visit"
                android:focusable="true"
                android:nextFocusDown="@id/btn_home_settings"
                android:nextFocusLeft="@id/et_url"
                android:nextFocusRight="@id/btn_visit"
                android:nextFocusUp="@id/btn_visit"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_go"
                android:stateListAnimator="@null"
                android:tag="visit_button"
                app:tint="@color/btn_primary_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_home_phone_remote"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/btn_tv_selector"
                android:focusable="true"
                android:minWidth="200dp"
                android:nextFocusLeft="@id/btn_home_phone_remote"
                android:nextFocusRight="@id/btn_home_settings"
                android:nextFocusUp="@id/et_url"
                android:nextFocusDown="@id/btn_home_phone_remote"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@null"
                android:tag="home_remote_button"
                android:text="@string/btn_phone_remote"
                android:textAllCaps="false"
                android:textColor="@color/btn_secondary_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_home_settings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_tv_selector"
                android:focusable="true"
                android:minWidth="200dp"
                android:nextFocusLeft="@id/btn_home_phone_remote"
                android:nextFocusRight="@id/btn_home_settings"
                android:nextFocusUp="@id/btn_visit"
                android:nextFocusDown="@id/btn_home_settings"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@null"
                android:tag="home_settings_button"
                android:text="@string/btn_settings"
                android:textAllCaps="false"
                android:textColor="@color/btn_secondary_text"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_home_remote_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/home_tip"
            android:textColor="@color/tv_text_hint"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_overlay"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="36dp"
            android:paddingEnd="56dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/title_remote_menu"
                        android:textColor="@color/tv_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/subtitle_remote_menu"
                        android:textColor="@color/tv_text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <View
                        android:id="@+id/dot_remote_status"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dot_active_green" />

                    <TextView
                        android:id="@+id/tv_remote_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/remote_status_ready"
                        android:textColor="@color/tv_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="268dp"
                    android:layout_height="268dp"
                    android:background="@drawable/bg_qr_card"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/iv_menu_qr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/qr_remote_description"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_menu_remote_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/placeholder_remote_url"
                    android:textColor="@color/tv_text"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/remote_same_network"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_menu_close"
                android:layout_width="240dp"
                android:layout_height="54dp"
                android:background="@drawable/btn_tv_selector"
                android:focusable="true"
                android:nextFocusDown="@id/btn_menu_close"
                android:nextFocusLeft="@id/btn_menu_close"
                android:nextFocusRight="@id/btn_menu_close"
                android:nextFocusUp="@id/btn_menu_close"
                android:stateListAnimator="@null"
                android:tag="menu_close_button"
                android:text="@string/btn_close"
                android:textAllCaps="false"
                android:textColor="@color/btn_secondary_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/back_menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_overlay"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="36dp"
            android:paddingEnd="56dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/title_back_menu"
                android:textColor="@color/tv_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle_back_menu"
                android:textColor="@color/tv_text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/label_now_playing"
                    android:textAllCaps="true"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_back_page_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/tv_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_back_page_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_url_chip"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:padding="12dp"
                    android:text=""
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/back_menu_hint"
                android:textColor="@color/tv_text_hint"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_back_history_back"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tv_selector"
                        android:focusable="true"
                        android:nextFocusLeft="@id/btn_back_history_back"
                        android:nextFocusRight="@id/btn_back_history_forward"
                        android:nextFocusUp="@id/btn_back_history_back"
                        android:nextFocusDown="@id/btn_back_change_url"
                        android:stateListAnimator="@null"
                        android:tag="back_history_back_button"
                        android:text="@string/btn_history_back"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_secondary_text"
                        android:textSize="16sp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_back_history_forward"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tv_selector"
                        android:focusable="true"
                        android:nextFocusLeft="@id/btn_back_history_back"
                        android:nextFocusRight="@id/btn_back_reload"
                        android:nextFocusUp="@id/btn_back_history_forward"
                        android:nextFocusDown="@id/btn_back_settings"
                        android:stateListAnimator="@null"
                        android:tag="back_history_forward_button"
                        android:text="@string/btn_history_forward"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_secondary_text"
                        android:textSize="16sp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_back_reload"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tv_selector"
                        android:focusable="true"
                        android:nextFocusLeft="@id/btn_back_history_forward"
                        android:nextFocusRight="@id/btn_back_reload"
                        android:nextFocusUp="@id/btn_back_reload"
                        android:nextFocusDown="@id/btn_back_exit"
                        android:stateListAnimator="@null"
                        android:tag="back_reload_button"
                        android:text="@string/btn_reload"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_secondary_text"
                        android:textSize="16sp" />
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_back_change_url"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tv_selector"
                        android:focusable="true"
                        android:nextFocusLeft="@id/btn_back_change_url"
                        android:nextFocusRight="@id/btn_back_settings"
                        android:nextFocusUp="@id/btn_back_history_back"
                        android:nextFocusDown="@id/btn_back_change_url"
                        android:stateListAnimator="@null"
                        android:tag="back_change_url_button"
                        android:text="@string/btn_change_url"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_secondary_text"
                        android:textSize="16sp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_back_settings"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tv_selector"
                        android:focusable="true"
                        android:nextFocusLeft="@id/btn_back_change_url"
                        android:nextFocusRight="@id/btn_back_exit"
                        android:nextFocusUp="@id/btn_back_history_forward"
                        android:nextFocusDown="@id/btn_back_settings"
                        android:stateListAnimator="@null"
                        android:tag="back_settings_button"
                        android:text="@string/btn_settings"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_secondary_text"
                        android:textSize="16sp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_back_exit"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tv_danger_selector"
                        android:focusable="true"
                        android:nextFocusLeft="@id/btn_back_settings"
                        android:nextFocusRight="@id/btn_back_exit"
                        android:nextFocusUp="@id/btn_back_reload"
                        android:nextFocusDown="@id/btn_back_exit"
                        android:stateListAnimator="@null"
                        android:tag="back_exit_button"
                        android:text="@string/btn_exit"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_danger_text"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/settings_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_bg"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="36dp"
        android:paddingEnd="56dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="@string/title_settings"
                android:textColor="@color/tv_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_settings_back"
                android:layout_width="148dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_tv_selector"
                android:focusable="true"
                android:nextFocusDown="@id/spinner_settings_language"
                android:nextFocusLeft="@id/btn_settings_back"
                android:nextFocusRight="@id/btn_settings_back"
                android:nextFocusUp="@id/btn_settings_back"
                android:stateListAnimator="@null"
                android:text="@string/btn_back"
                android:textAllCaps="false"
                android:textColor="@color/btn_secondary_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/label_language"
                    android:textAllCaps="true"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinner_settings_language"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/spinner_tv_selector"
                    android:dropDownSelector="@android:color/transparent"
                    android:focusable="true"
                    android:nextFocusDown="@id/et_settings_start_url"
                    android:nextFocusUp="@id/btn_settings_back"
                    android:overlapAnchor="false"
                    android:popupBackground="@drawable/bg_card_dark"
                    android:spinnerMode="dropdown" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@color/tv_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/section_startup"
                    android:textAllCaps="true"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_startup_url"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_settings_start_url"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_tv_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="monospace"
                        android:nextFocusDown="@id/btn_settings_save_url"
                        android:nextFocusLeft="@id/et_settings_start_url"
                        android:nextFocusRight="@id/btn_settings_clear_url"
                        android:nextFocusUp="@id/spinner_settings_language"
                        android:hint="@string/hint_enter_url"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/tv_text"
                        android:textColorHint="@color/tv_text_hint"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_settings_clear_url"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/btn_tv_danger_selector"
                        android:contentDescription="@string/btn_clear"
                        android:focusable="true"
                        android:nextFocusDown="@id/btn_settings_save_url"
                        android:nextFocusLeft="@id/et_settings_start_url"
                        android:nextFocusRight="@id/btn_settings_clear_url"
                        android:nextFocusUp="@id/spinner_settings_language"
                        android:padding="14dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close"
                        android:stateListAnimator="@null"
                        app:tint="@color/btn_danger_text" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_settings_save_url"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_tv_selector"
                    android:focusable="true"
                    android:nextFocusDown="@id/spinner_settings_ua"
                    android:nextFocusUp="@id/et_settings_start_url"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_save_start_url"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_secondary_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_user_agent"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinner_settings_ua"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/spinner_tv_selector"
                    android:dropDownSelector="@android:color/transparent"
                    android:focusable="true"
                    android:nextFocusDown="@id/spinner_settings_nic"
                    android:nextFocusUp="@id/btn_settings_save_url"
                    android:overlapAnchor="false"
                    android:popupBackground="@drawable/bg_card_dark"
                    android:spinnerMode="dropdown" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@color/tv_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/section_phone_remote"
                    android:textAllCaps="true"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_network_interface"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinner_settings_nic"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/spinner_tv_selector"
                    android:dropDownSelector="@android:color/transparent"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_settings_regen_token"
                    android:nextFocusUp="@id/spinner_settings_ua"
                    android:overlapAnchor="false"
                    android:popupBackground="@drawable/bg_card_dark"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:id="@+id/tv_settings_ip_remote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="@color/tv_text"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_settings_regen_token"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_tv_selector"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_settings_regen_token"
                    android:nextFocusUp="@id/spinner_settings_nic"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_regen_token"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_secondary_text"
                    android:textSize="15sp" />
            </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/section_about"
                    android:textAllCaps="true"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_settings_sys_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="8dp"
                    android:text="@string/placeholder_about"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="680dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/title_error"
                android:textColor="@color/tv_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_url_chip"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/placeholder_example_url"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_error_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/msg_error_hint"
                android:textColor="@color/tv_text_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_error_retry"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_primary_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_error_retry"
                    android:nextFocusRight="@id/btn_error_change_url"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_primary_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btn_error_change_url"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_error_retry"
                    android:nextFocusRight="@id/btn_error_phone_remote"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_change_url"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_secondary_text"
                    android:textSize="17sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btn_error_phone_remote"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_error_change_url"
                    android:nextFocusRight="@id/btn_error_phone_remote"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_phone_remote"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_secondary_text"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/exit_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_overlay"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_exit"
                android:textColor="@color/tv_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/msg_exit_confirm"
                android:textColor="@color/tv_text_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_exit_cancel"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_exit_cancel"
                    android:nextFocusRight="@id/btn_exit_confirm"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_secondary_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btn_exit_confirm"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_danger_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_exit_cancel"
                    android:nextFocusRight="@id/btn_exit_confirm"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_confirm_exit"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_danger_text"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
