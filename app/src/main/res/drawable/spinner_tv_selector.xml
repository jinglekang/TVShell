<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_elevated_focus" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/tv_focus_stroke" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item
                android:width="20dp"
                android:height="20dp"
                android:drawable="@drawable/ic_expand_more"
                android:gravity="end|center_vertical"
                android:right="14dp" />
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_elevated_focus" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/tv_focus_stroke" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item
                android:width="20dp"
                android:height="20dp"
                android:drawable="@drawable/ic_expand_more"
                android:gravity="end|center_vertical"
                android:right="14dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_elevated" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item
                android:width="20dp"
                android:height="20dp"
                android:drawable="@drawable/ic_expand_more"
                android:gravity="end|center_vertical"
                android:right="14dp" />
        </layer-list>
    </item>
</selector>
